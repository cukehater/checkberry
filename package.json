{
  "name": "checkberry",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@marceloterreiro/flash-calendar": "^2.0.0",
    "@shopify/flash-list": "2.3.2",
    "clsx": "^2.1.1",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
