  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@phosphor-icons/core": "^2.1.1",
    "@types/jest": "30.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "knip": "^6.46.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "arch": "steiger ./src",
    "verify": "expo lint && prettier --check . && steiger ./src && knip",
    "prepare": "husky",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "icons:gen": "node scripts/gen-phosphor-icons.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|uniwind))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "packageManager": "pnpm@10.31.0"
}
